{
  "name": "opencode-usage",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/riggyz/opencode-usage.git"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "description": "Account quota wheels and reset countdowns for OpenCode V2 desktop",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && bun test",
    "audit": "bun audit",
    "preversion": "bun run check",
    "version": "bun run build && git add dist/gui-experimental.cjs",
    "claude-statusline": "bun scripts/claude-statusline.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.6.2",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
